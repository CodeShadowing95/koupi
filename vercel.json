{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "buildCommand": "npm run db:migrate && npm run db:import && npm run build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "develop": true,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/retest",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/podcasts",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/youtube-channels",
      "schedule": "0 4 * * *"
    }
  ]
}
