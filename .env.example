DATABASE_URL=
ADMIN_PASSWORD=
SESSION_SECRET=
# Connexion des créateurs par lien (ADR-0021) : clé Resend et expéditeur d'un domaine vérifié chez Resend,
# ex. EMAIL_FROM="Merkod <bonjour@merkod.fr>". Sans eux : le lien s'affiche dans la console en local, la connexion reste fermée en production.
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Adresse publique du site, utilisée dans les liens envoyés par e-mail (obligatoire en production).
NEXT_PUBLIC_APP_URL=http://localhost:3000
HASH_SALT=
# YouTube Data API v3 key: local scripts (`npm run avatars`, sourcing) and the admin Vérifications page (reads video descriptions)
YOUTUBE_API_KEY=
# Logo.dev publishable key (pk_…), used only by `npm run logos` to download tool logos
LOGO_DEV_TOKEN=
# Local Claude Code only: 21st.dev Magic MCP key (https://21st.dev/magic/console)
TWENTYFIRST_API_KEY=
# IA des vérifications (ADR-0013). Sans clé, l'IA reste inactive et l'admin affiche « IA en attente d'activation ».
ANTHROPIC_API_KEY=
# Facultatif : modèle de première lecture (claude-haiku-5-5 par défaut), modèle de deuxième lecture (claude-opus-5-5 par défaut),
# plafond mensuel en euros (10 par défaut), taux euro → dollar (1.2 par défaut)
AI_MODEL=
AI_REVIEW_MODEL=
AI_MONTHLY_BUDGET_EUR=
AI_USD_PER_EUR=

# Retests automatiques (tâche planifiée Vercel, chaque nuit) : secret d'au moins 32 caractères.
# Vercel l'envoie à /api/cron/retest ; sans lui, la tâche est désactivée.
CRON_SECRET=
